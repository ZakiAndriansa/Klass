# Salin berkas ini menjadi `.env`, lalu sesuaikan nilainya.
# `.env` tidak ikut di-commit. Jangan menaruh rahasia asli di berkas contoh ini.

# Alamat database. Pakai SALAH SATU baris DATABASE_URL, sesuai sumber MySQL-mu.
# Panduan lengkapnya ada di README.md bagian "Menjalankan di laptop".

# Pilihan A, Docker (`npm run db:up`): MySQL di port 3307.
DATABASE_URL=mysql://klass:klass_dev@localhost:3307/klass

# Pilihan B, Laragon: MySQL di port 3306, pengguna root tanpa kata sandi.
# Buat dulu database `klass`, lalu hapus tanda # di baris bawah dan beri # pada baris Pilihan A.
# DATABASE_URL=mysql://root@localhost:3306/klass

# Alamat aplikasi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login Google. Tanpa tiga baris ini aplikasi tetap jalan dan masuknya lewat /dev/login.
# Cara mendapatkannya ada di src/server/auth/README.md bagian "Mengaktifkan login Google".
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
