# Salin berkas ini menjadi `.env`, lalu sesuaikan nilainya.
# `.env` tidak ikut di-commit. Jangan menaruh rahasia asli di berkas contoh ini.

# Alamat database. Nilai di bawah cocok dengan `compose.yaml` (MySQL di port 3307).
DATABASE_URL=mysql://klass:klass_dev@localhost:3307/klass

# Alamat aplikasi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dipakai nanti saat login Google dipasang. Biarkan tetap berupa komentar untuk sekarang.
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
